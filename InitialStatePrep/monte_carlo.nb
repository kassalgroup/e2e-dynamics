Cell[CellGroupData[{

Cell["Read in length and maximum momentum", "Section",
 CellChangeTimes->{{3.9978417588358717`*^9, 
  3.997841793750477*^9}},ExpressionUUID->"76d851db-577d-4fd2-87cf-\
891ed2d21d6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "file", " ", "name", " ", "or", " ", "_isp", "_final", 
    RowBox[{"_data", ".", "out"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ispFinalDataFile", " ", "=", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "molecularDataPath", ",", "myDir", ",", "\"\<Output/\>\"", ",", 
        "myMolec", ",", "\"\<_isp_final_data.out\>\""}], " ", "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"read", " ", "in", " ", "data", " ", "as", " ", "text"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ispFinalDataFileTxt", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"ispFinalDataFile", ",", "\"\<Text\>\""}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"prase", " ", "text", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lines", "=", 
     RowBox[{
      RowBox[{"StringSplit", "[", 
       RowBox[{"ispFinalDataFileTxt", ",", 
        RowBox[{"RegularExpression", "[", "\"\<\\\\R\>\"", "]"}]}], "]"}], "//", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{"\"\<\>\"", "|", "Whitespace"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kv", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StringSplit", "[", 
        RowBox[{"#", ",", "\"\<=\>\"", ",", "2"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"params", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"kv", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{"keys", " ", "as", " ", "strings"}], "*)"}], 
       RowBox[{"ToExpression", "/@", 
        RowBox[{"kv", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"values", " ", "as", " ", "numbers"}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"set", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kmax", " ", "=", 
     RowBox[{"params", "[", "\"\<elec_k_max\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", 
     RowBox[{"params", "[", "\"\<L\>\"", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.997841794842208*^9, 3.9978419526775827`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"04c39957-d8a7-48c2-8481-00c7359cbb46"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read in trim error budget", "Section",
 CellChangeTimes->{{3.997841957498723*^9, 
  3.9978419714319677`*^9}},ExpressionUUID->"226d2345-3e9a-49ad-be53-\
1414f25f92a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Read", " ", "the", " ", "error"}], "-", 
    RowBox[{"budget", " ", "input", " ", 
     RowBox[{"file", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"errorBudgetFile", "=", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "molecularDataPath", ",", "myDir", ",", "myMolec", ",", 
        "\"\<_error_budget.in\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errorBudgetFileTxt", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"errorBudgetFile", ",", "\"\<Text\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Remove", " ", "blank", " ", "lines", " ", "and", " ", "surrounding", " ", 
     RowBox[{"whitespace", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"lines", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"StringTrim", "/@", 
        RowBox[{"StringSplit", "[", 
         RowBox[{"errorBudgetFileTxt", ",", 
          RowBox[{"RegularExpression", "[", "\"\<\\\\R\>\"", "]"}]}], "]"}]}],
        ",", "\"\<\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Split", " ", "each", " ", "line", " ", "into", " ", "a", " ", 
     "parameter", " ", "name", " ", "and", " ", 
     RowBox[{"value", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"keyValuePairs", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StringSplit", "[", 
        RowBox[{"#", ",", "\"\<=\>\"", ",", "2"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Convert", " ", "e"}], "-", 
     RowBox[{"style", " ", "scientific", " ", "notation", " ", "to", " ", 
      RowBox[{"Mathematica", "'"}], "s", "*", 
      RowBox[{
       RowBox[{"^", "notation"}], "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"parseNumber", "[", "value_String", "]"}], ":=", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{
        RowBox[{"StringTrim", "[", "value", "]"}], ",", 
        RowBox[{
         RowBox[{
         "RegularExpression", "[", "\"\<([0-9.])[eE]([+-]?[0-9]+)$\>\"", 
          "]"}], "->", "\"\<$1*^$2\>\""}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Store", " ", "the", " ", "parameters", " ", "in", " ", "an", " ", 
     RowBox[{"association", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"budget", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"keyValuePairs", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"parseNumber", "/@", 
        RowBox[{"keyValuePairs", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "the", " ", "trimming", " ", "error", " ", 
     RowBox[{"budget", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"trimBudget", "=", 
     RowBox[{"budget", "[", "\"\<trim_budget\>\"", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9978419842515907`*^9, 3.9978419927215652`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"c402c179-066c-4a37-b051-cd7a32ed8a42"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute derived quantities", "Section",
 CellChangeTimes->{{3.997842030031004*^9, 
  3.997842034819578*^9}},ExpressionUUID->"bbae4424-88d0-453b-ac99-\
dc8fb548bc10"],

Cell["\<\
nTotal is computed using a one-sided confidence interval. Sometimes, the \
computed value for nTotal can be quite large. For testing, it is helpful to \
first set nTotal manually to smaller value so that the calculation completes \
in a reasonable time.\
\>", "Text",
 CellChangeTimes->{{3.9978433949604187`*^9, 3.9978434013007383`*^9}, {
  3.9978435116808023`*^9, 
  3.9978436040206633`*^9}},ExpressionUUID->"7af30968-dd8e-4a1b-9418-\
a3c9d658ff40"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]", " ", "=", " ", 
   RowBox[{"2", "*", 
    RowBox[{"\[Pi]", "/", "L"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NpwHalf", " ", "=", " ", 
    RowBox[{"Ceiling", "[", 
     RowBox[{"kmax", "*", 
      RowBox[{"L", "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi"}], ")"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Enforce", " ", "numerical", " ", 
     RowBox[{"symmetry", ".", " ", "Otheriwse"}]}], ",", " ", 
    RowBox[{
    "MultinormalDistribution", " ", "does", " ", "not", " ", "always", " ", 
     "accept", " ", "lambdaMat"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lambdaMat", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"lambdaMat", "+", 
      RowBox[{"Transpose", "[", "lambdaMat", "]"}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaScaled", "=", 
    RowBox[{"2", " ", "*", "lambdaMat", " ", "*", " ", 
     SuperscriptBox["\[CapitalDelta]", "2"]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Enforce", " ", "symmetry", " ", "again", " ", "after", " ", 
    "arithmetic"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaScaled", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"lambdaScaled", "+", 
       RowBox[{"Transpose", "[", "lambdaScaled", "]"}]}], ")"}], "/", "2"}]}],
    ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", " ", "=", "  ", 
   RowBox[{"Length", "[", "lambdaMat", "]"}]}], ";"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"mu", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", "dim"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "total", " ", "number", " ", "of", " ", "MC", " ", "steps",
     " ", "needed", " ", "for", " ", "target", " ", "error", " ", "trimming", 
    " ", "error", " ", "budget"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nTotal", "=", 
   RowBox[{"Ceiling", "[", 
    RowBox[{
     RowBox[{"Log", "[", "trimBudget", "]"}], "/", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", " ", 
       SuperscriptBox["trimBudget", "2"]}], "]"}]}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.997842036384817*^9, 3.99784205110752*^9}, {
  3.997842088202142*^9, 3.9978421725231953`*^9}, {3.997842226821257*^9, 
  3.997842283568919*^9}, {3.997844399671281*^9, 3.997844409915326*^9}, {
  3.997935446465889*^9, 3.99793544731389*^9}, {3.997977775792551*^9, 
  3.997977776161882*^9}, {3.998079406851317*^9, 3.998079418614648*^9}, {
  3.9997325933606253`*^9, 3.999732593780168*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"0d79a171-7bb5-4ba2-8acc-eb50867a85ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Run MC calculation", "Section",
 CellChangeTimes->{{3.9955874175989513`*^9, 
  3.995587425625551*^9}},ExpressionUUID->"921ddaf0-e406-439b-b4a8-\
710d25780f1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Create", " ", "multivariate", " ", "gaussian", " ", "object"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dist", "=", 
    RowBox[{"MultinormalDistribution", "[", 
     RowBox[{"mu", ",", "lambdaScaled"}], "]"}]}], ";"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.997842175760854*^9, 3.997842191274995*^9}, {
  3.998079557233416*^9, 3.9980795579957542`*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"31733e78-2088-4268-b668-f39255d40c80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Monte", " ", "carlo", " ", "calculation"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"count", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"total", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", " ", "=", 
     RowBox[{"-", "NpwHalf"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", " ", "=", "NpwHalf"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"batch", ",", 
          RowBox[{"nTotal", "-", "total"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"m", "<=", "0"}], ",", 
         RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"samp", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{"dist", ",", 
           RowBox[{"{", "m", "}"}]}], "]"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "always", " ", "a", " ", "list", " ", "of", " ", "m", " ", 
         "vectors"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"rowMaxes", "=", 
        RowBox[{"Max", "/@", "samp"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hits", "=", 
        RowBox[{"Boole", "[", 
         RowBox[{"Thread", "[", 
          RowBox[{"rowMaxes", "<=", "b"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"count", "+=", 
        RowBox[{"Total", "[", "hits", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"total", "+=", "m"}], ";"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"Ceiling", "[", 
        RowBox[{"nTotal", "/", "batch"}], "]"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "probability", " ", "estimate", " ", "from", " ", "your", " ", "hit", " ",
      "count"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pHat", "=", 
     RowBox[{"N", "[", 
      RowBox[{"count", "/", "total"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"confidence", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "-", "trimBudget"}], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pLowerBound", " ", "=", " ", 
     RowBox[{
      SuperscriptBox["trimBudget", 
       RowBox[{"1", "/", "nTotal"}]], "//", "N"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trimErrorUpperBound", " ", "=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", "pLowerBound"}], "]"}], "//", "N"}]}], 
    ";"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.978921933720913*^9, 3.978922013526395*^9}, {
   3.97892404544394*^9, 3.978924077954689*^9}, {3.978924134423658*^9, 
   3.9789241366491137`*^9}, 3.978924647632227*^9, {3.978925259063109*^9, 
   3.978925262172449*^9}, {3.978991488542886*^9, 3.978991490080656*^9}, 
   3.9956748950583878`*^9, {3.9956752716419773`*^9, 3.995675284519352*^9}, 
   3.9978421912751303`*^9, 3.997843639832458*^9, {3.997844367667598*^9, 
   3.997844387176013*^9}, {3.997844469586554*^9, 3.9978444967930403`*^9}, {
   3.997844602249249*^9, 3.997844605902302*^9}, {3.9978448200239964`*^9, 
   3.997844844746257*^9}, {3.997844891600678*^9, 3.997844892001051*^9}, {
   3.997844938069043*^9, 3.997844955329323*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"d891cfc7-c18b-4016-abc0-88006493bb38"]
}, Open  ]]
}, Open  ]],

