Cell[CellGroupData[{

Cell["Set Monte Carlo Batch size", "Section",
 CellChangeTimes->{{3.9978430989218607`*^9, 
  3.997843107747118*^9}},ExpressionUUID->"ec221a8b-e398-4866-b998-\
380c28e0cbc9"],

Cell["\<\
batch specifies the number of iterations processed and held in memory at one \
time by the RandomVariate function used for Monte Carlo sampling. Larger \
batch sizes generally require more memory, but can reduce the total \
calculation time.
For reference, we find that for Criegee, using 10^8 total Monte Carlo samples \
and batch = 100,000, requires approximately 1 minute to complete the Monte \
Carlo calculation using a 16 GB Apple M1 chip.\
\>", "Text",
 CellChangeTimes->{{3.9978431335845823`*^9, 3.997843359906681*^9}, {
  3.997935996769659*^9, 3.997935999898855*^9}, {3.997936751686838*^9, 
  3.9979367533610907`*^9}},ExpressionUUID->"d4322661-4390-42c9-af8a-\
6adfc92169fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"batch", "=", "1000000"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"number", " ", "of", " ", "samples", " ", "per", " ", "batch"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.997843108804986*^9, 3.997843130660923*^9}, 
   3.997935159416357*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"2bd3448f-bbeb-484a-a2b7-471c9b50a9bd"]
}, Open  ]],

