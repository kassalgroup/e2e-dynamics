Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"create", " ", "path", " ", "to", " ", "MolecularData"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"molecularDataPath", "=", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"DirectoryName", "[", 
          RowBox[{"DirectoryName", "[", 
           RowBox[{"NotebookFileName", "[", "]"}], "]"}], "]"}], ",", 
         "\"\<MolecularData\>\""}], "}"}], "]"}], "<>", 
      "$PathnameSeparator"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"create", " ", "file", " ", "name", " ", "for", " ", 
     RowBox[{"lambda_mat", ".", "out"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lambdaFile", " ", "=", " ", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "molecularDataPath", ",", "myDir", ",", " ", "\"\<Output/\>\"", " ", 
        ",", "myMolec", ",", "\"\<_lambda_mat.out\>\""}], " ", "}"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"read", " ", "in", " ", "data", " ", "from", " ", "_lambda", 
     RowBox[{"_mat", ".", "out"}], " ", "file"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lambdaMat", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"lambdaFile", ",", "\"\<CSV\>\""}], "]"}]}], ";"}]}]}]], "Input",\

 CellChangeTimes->{{3.997841658147027*^9, 3.9978417566054573`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"69d4bb8d-d722-4bde-b59c-66a593ebaa3c"]
